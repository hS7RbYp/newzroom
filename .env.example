# Example .env file for local development
# Copy to .env and fill in your values

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>

# Cosmos DB
COSMOS_ENDPOINT=https://<your-resource>.documents.azure.com:443/
COSMOS_KEY=<your-primary-key>

# Azure AI Search
SEARCH_ENDPOINT=https://<your-resource>.search.windows.net/
SEARCH_KEY=<your-admin-key>

# Service Bus
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://<your-resource>.servicebus.windows.net/;...

# Azure Foundry
FOUNDRY_PROJECT_CONNECTION_STRING=<foundry-project-connection>

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
